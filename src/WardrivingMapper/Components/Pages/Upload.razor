@page "/Upload"

<MudCard>
    <MudCardContent>
        <MudText Typo="Typo.h6">Import csv Data</MudText>
        <br/>
        <MudFileUpload T="IBrowserFile" FilesChanged="OnFileChange" Class="mud-width-full">
            <CustomContent>
                <MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined" Class="mud-width-full">
                    <MudButton Variant="Variant.Filled"  OnClick="@context.OpenFilePickerAsync" Style="min-width: 150px;">
                        Choose file
                    </MudButton>
                    <MudPaper Class="mud-width-full flex-wrap d-flex align-center justify-center mud-border-primary mud-text-primary"
                        Style="background-color:inherit;"
                        Outlined="true">
                        @(context.GetFilenames().Count > 0 ? context.GetFilenames()[0] : string.Empty)
                    </MudPaper>
                </MudButtonGroup>
            </CustomContent>
            <SelectedTemplate />
        </MudFileUpload>
    </MudCardContent>
</MudCard>
@if (_importResult != null)
{
    <MudCard>
        <MudCardContent>
            <MudText Typo="Typo.h6">Details</MudText>
            <MudText Typo="Typo.body1">Number of records: @_importResult.TotalRecords</MudText>
            <MudText Typo="Typo.body1">Number of WiFi: @_importResult.WifiCount</MudText>
            <MudText Typo="Typo.body1">Number of BLE: @_importResult.BleCount</MudText>
            <MudText Typo="Typo.body1">Number of BT: @_importResult.BtCount</MudText>
            <MudText Typo="Typo.body1">Number of LTE: @_importResult.LteCount</MudText>
        </MudCardContent>
    </MudCard>

    <MudButton OnClick="ImportData" Color="Color.Primary" Variant="Variant.Filled">
        <MudIcon Icon="@Icons.Material.Filled.Upload"/>
        Upload
    </MudButton>
}